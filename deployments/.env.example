# Variáveis de Ambiente - DSM Conecta Deployments

# Banco de Dados (PostgreSQL / TimescaleDB)
POSTGRES_DB=dsm_conecta
POSTGRES_USER=dsm_user
POSTGRES_PASSWORD=dsm_password

# Broker MQTT (Eclipse Mosquitto)
# Credenciais dos perfis de acesso
MQTT_APP_USER=app_user
MQTT_APP_PASSWORD=app_pass_dev

MQTT_SIMULATOR_USER=simulator_user
MQTT_SIMULATOR_PASSWORD=simulator_pass_dev

MQTT_INGESTOR_USER=ingestor_user
MQTT_INGESTOR_PASSWORD=ingestor_pass_dev

MQTT_ADMIN_USER=admin_user
MQTT_ADMIN_PASSWORD=admin_pass_dev
